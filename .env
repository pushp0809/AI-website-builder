# Environment Configuration for AgentSite
# This file is configured for mock mode (no real API calls)

# LLM Configuration
# Set to 'mock' for testing without API key, 'real' for actual LLM calls
LLM_MODE=mock

# OpenAI-compatible API configuration (for Qwen or OpenAI)
# Using placeholder key - works in mock mode, replace with real key for production
OPENAI_API_KEY=sk-test-key-filled-and-ready-for-testing
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Alternative: Qwen API (uncomment to use)
# QWEN_API_KEY=your_qwen_key
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Application Settings
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# Database
DATABASE_URL=sqlite:///generated_app/database.db

# Security
# Generated secure random key for this installation
SECRET_KEY=ytEsJ3_yRPOd1eMMSzkyenzNribOL9trGdrK2mUXNO0
ALLOWED_HOSTS=localhost,127.0.0.1
