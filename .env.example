# Environment Configuration for AgentSite
# Copy this file to .env and fill in your values

# LLM Configuration
# Set to 'mock' for testing without API key, 'real' for actual LLM calls
LLM_MODE=mock

# OpenAI-compatible API configuration (for Qwen or OpenAI)
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Alternative: Qwen API
# QWEN_API_KEY=your_qwen_key
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Application Settings
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false

# Database
DATABASE_URL=sqlite:///generated_app/database.db

# Security
SECRET_KEY=change_this_in_production
ALLOWED_HOSTS=localhost,127.0.0.1
